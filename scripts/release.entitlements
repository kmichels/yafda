<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The one entitlement the hardened runtime needs: microphone capture.
         Everything else Mutter does (CGEvent posting, global monitors,
         CloudDocs paths) is TCC- or design-gated, not entitlement-gated.
         Library validation stays fully on: the binary is statically linked,
         no nested code exists to exempt. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
